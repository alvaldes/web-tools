---
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="A comprehensive collection of web resources and tools"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-[100dvh]">
    <div
      class="relative min-h-[100dvh] h-full w-full grid grid-rows-[1fr,0.1fr]"
    >
      <div
        class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:40px_50px] [mask-image:radial-gradient(ellipse_80%_20%_at_50%_0%,#000_70%,transparent_110%)] -z-10"
      >
      </div>
      <slot />
      <Footer />
    </div>
    <style is:global>
      :root {
        --accent: #81689d;
        --accent-light: #fb77c6;
        --accent-dark: #474f7a;

        /* Semantic tokens re-exported as --color-* in src/styles/global.css
           (bg-card, text-muted-foreground, ring-ring, ...). Dark-only palette:
           change a value here and the whole app follows. */
        --background: #0f1015;
        --foreground: #f0f0f0;
        --card: #161820;
        --card-foreground: #f0f0f0;
        --popover: #1a1d29;
        --popover-foreground: #f0f0f0;
        --muted: #232734;
        --muted-foreground: #9aa3b2;
        --border: #2c3140;
        --input: #2c3140;
        --ring: #81689d;
        --primary: #2563eb;
        --primary-foreground: #ffffff;
        /* A dedicated link colour, separate from --primary, which is a *fill* token for the
           blue search button. #2563eb only reaches 2.88:1 as text on the --muted footer,
           below the 4.5:1 a 14px label needs; #60a5fa reaches 5.86:1 there and 6.97:1 on
           --card. Do not collapse the two roles back into one token. */
        --link: #60a5fa;
      }
      html {
        font-family: system-ui, sans-serif;
        background: var(--background);
        color: var(--foreground);
      }
      code {
        font-family:
          Menlo,
          Monaco,
          Lucida Console,
          Liberation Mono,
          DejaVu Sans Mono,
          Bitstream Vera Sans Mono,
          Courier New,
          monospace;
      }
    </style>
  </body>
</html>
