---
import Logo from "./Logo.astro";
---

<footer class="">
  <div class="mx-auto w-full p-4 lg:py-8">
    <hr class="my-6 sm:mx-auto border-gray-700 lg:my-8" />
    
    <!-- Main footer content -->
    <div class="flex flex-col items-center gap-4">
      <!-- Logo and tagline -->
      <div class="flex items-center gap-2">
        <a
          href="/"
          aria-label="web-tools"
          class="focus:ring-2 focus:outline-none"
        >
          <Logo class="size-5 text-white" />
        </a>
        <span class="text-sm text-muted-foreground">
          ωεβ Τσφδ
        </span>
      </div>

      <!-- Creator info -->
      <div class="text-center">
        <p class="text-sm text-muted-foreground">
          Created by <a href="https://alvaldes.dev" target="_blank" rel="noopener noreferrer" class="text-foreground hover:underline">alvaldes</a>
        </p>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <a
          href="https://github.com/alvaldes/web-tools/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground focus:ring-2 focus:outline-none"
        >
          Contribute
        </a>
        <a
          href="https://github.com/alvaldes/web-tools"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground focus:ring-2 focus:outline-none"
          aria-label="GitHub"
        >
          <svg
            class="w-5 h-5"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 .333A9.911 9.911 0 0 0 6.866 19.65c.5.092.678-.215.678-.477 0-.237-.01-1.017-.014-1.845-2.757.6-3.338-1.169-3.338-1.169a2.627 2.627 0 0 0-1.1-1.451c-.9-.615.07-.6.07-.6a2.084 2.084 0 0 1 1.518 1.021 2.11 2.11 0 0 0 2.884.823c.044-.503.268-.973.63-1.325-2.2-.25-4.516-1.1-4.516-4.9A3.832 3.832 0 0 1 4.7 7.068a3.56 3.56 0 0 1 .095-2.623s.832-.266 2.726 1.016a9.409 9.409 0 0 1 4.962 0c1.89-1.282 2.717-1.016 2.717-1.016.366.83.402 1.768.1 2.623a3.827 3.827 0 0 1 1.02 2.659c0 3.807-2.319 4.644-4.525 4.889a2.366 2.366 0 0 1 .673 1.834c0 1.326-.012 2.394-.012 2.72 0 .263.18.572.681.475A9.911 9.911 0 0 0 10 .333Z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <a
          href="https://alvaldes.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground focus:ring-2 focus:outline-none"
          aria-label="Portfolio"
        >
          <svg
            class="w-5 h-5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </a>
      </div>

      <!-- License -->
      <p class="text-xs text-muted-foreground">
        MIT License · Open Source
      </p>
    </div>
  </div>
</footer>
